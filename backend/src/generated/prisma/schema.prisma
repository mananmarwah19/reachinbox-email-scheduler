generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  name      String
  email     String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailBatches    EmailBatch[]
  emails          Email[]
  senders         Sender[]
  slackConnection SlackConnection?
}

model EmailBatch {
  id           String   @id @default(uuid())
  userId       String
  subject      String
  body         String
  startTime    DateTime
  delaySeconds Int
  hourlyLimit  Int
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@index([userId])
}

model Email {
  id             String      @id @default(uuid())
  batchId        String
  userId         String
  senderId       String
  recipient      String
  subject        String
  body           String
  scheduledAt    DateTime
  sentAt         DateTime?
  status         EmailStatus @default(SCHEDULED)
  bullJobId      String?     @unique
  idempotencyKey String      @unique
  errorMessage   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  batch  EmailBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender     @relation(fields: [senderId], references: [id])

  @@index([userId, status])
  @@index([scheduledAt])
  @@index([recipient])
}

model Sender {
  id           String   @id @default(uuid())
  userId       String
  email        String   @unique
  displayName  String?
  smtpHost     String
  smtpPort     Int
  smtpUser     String
  smtpPassword String
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@index([userId])
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  accessToken String
  slackUserId String?
  teamId      String?
  teamName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}
